# 微信公众号
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 知乎
ZHIHU_USERNAME=your_zhihu_username
ZHIHU_PASSWORD=your_zhihu_password

# B站
BILIBILI_SESS_DATA=your_bilibili_sess_data
BILIBILI_CSRF=your_bilibili_csrf

# 小红书
XIAOHONGSHU_COOKIE=your_xiaohongshu_cookie

# 抖音（可选）
DOUYIN_COOKIE=your_douyin_cookie

# 微博（可选）
WEIBO_COOKIE=your_weibo_cookie

# RPA浏览器登录态复用（可选）
# 默认会在用户目录下创建专用浏览器Profile。建议先在设置页完成预登录，
# 后续真实发布会直接复用登录态，不会临时要求扫码/验证码。
MULTI_PUBLISHER_RPA_PERSIST_PROFILE=true
MULTI_PUBLISHER_RPA_AUTO_LOGIN=false
# MULTI_PUBLISHER_RPA_PROFILE_DIR=~/.multi_publisher/browser_profiles

# ──────────────────────────────────────
# AI 大模型配置（MiMo）
# ──────────────────────────────────────
MIMO_API_KEY=tp-your-api-key
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5-pro
